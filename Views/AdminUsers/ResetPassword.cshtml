@model FluentMY.ViewModels.AdminResetPasswordViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Reset Password";
}

<style>
    .reset-shell {
        color: #1f2937;
    }

    .reset-hero {
        border-radius: 24px;
        background: linear-gradient(135deg, #0ea5e9 0%, #0369a1 100%);
        color: #fff;
        padding: 30px;
        margin-bottom: 24px;
        box-shadow: 0 18px 36px rgba(14, 165, 233, 0.20);
    }

        .reset-hero h2 {
            margin: 0 0 8px;
            font-weight: 900;
        }

    .reset-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(15,23,42,0.06);
        box-shadow: 0 12px 28px rgba(15,23,42,0.06);
        padding: 24px;
    }

        .reset-card .form-group {
            margin-bottom: 18px;
        }

        .reset-card .form-control {
            border-radius: 12px;
            min-height: 44px;
        }
</style>

<div class="reset-shell">
    <div class="reset-hero">
        <h2>Reset User Password</h2>
        <p>Set a new password for this user account.</p>
    </div>

    <div class="reset-card">
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

        <div class="panel panel-default" style="margin-bottom:20px;">
            <div class="panel-body">
                <p><strong>Full Name:</strong> @(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)</p>
                <p><strong>Username:</strong> @Model.UserName</p>
                <p><strong>Email:</strong> @Model.Email</p>
            </div>
        </div>

        @if (Model.IsSelf)
        {
            <div class="alert alert-warning">
                Please use Change Password for your own account.
            </div>

            <a class="btn btn-default" href="@Url.Action("Index")">Back</a>
        }
        else
        {
            using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UserId)

                <div class="form-group">
                    @Html.LabelFor(m => m.NewPassword)
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Enter new password" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.ConfirmPassword)
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm new password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-info">Reset Password</button>
                <a class="btn btn-default" href="@Url.Action("Index")">Cancel</a>
            }
        }
    </div>
</div>