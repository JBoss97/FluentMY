@model FluentMY.ViewModels.AdminUserListItemViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete User";
}

<style>
    .delete-shell {
        color: #1f2937;
    }

    .delete-hero {
        border-radius: 24px;
        background: linear-gradient(135deg, #dc3545 0%, #b02a37 100%);
        color: #fff;
        padding: 30px;
        margin-bottom: 24px;
        box-shadow: 0 18px 36px rgba(220, 53, 69, 0.20);
    }

        .delete-hero h2 {
            margin: 0 0 8px;
            font-weight: 900;
        }

    .delete-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(15,23,42,0.06);
        box-shadow: 0 12px 28px rgba(15,23,42,0.06);
        padding: 24px;
    }

    .ownership-pill {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        margin-right: 6px;
        background: #f3f4f6;
        color: #374151;
    }
</style>

<div class="delete-shell">
    <div class="delete-hero">
        <h2>Delete User</h2>
        <p>Review the account details carefully before permanent removal.</p>
    </div>

    @if (Model.IsSelf)
    {
        <div class="alert alert-warning">
            You cannot delete your own admin account.
        </div>

        <a class="btn btn-default" href="@Url.Action("Index")">Back</a>
    }
    else
    {
        <div class="delete-card">
            @if (Model.HasOwnedContent)
            {
                <div class="alert alert-warning">
                    This educator still owns academic content. Reassign ownership before deleting this account.
                </div>

                <p>
                    @if (Model.OwnedCourseCount > 0)
                    {
                        <span class="ownership-pill">@Model.OwnedCourseCount course(s)</span>
                    }
                    @if (Model.OwnedLessonCount > 0)
                    {
                        <span class="ownership-pill">@Model.OwnedLessonCount lesson(s)</span>
                    }
                </p>
            }
            else
            {
                <div class="alert alert-warning">
                    Are you sure you want to delete this user?
                </div>
            }

            <div class="panel panel-default" style="margin-bottom:20px;">
                <div class="panel-body">
                    <p><strong>Full Name:</strong> @(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)</p>
                    <p><strong>Username:</strong> @Model.UserName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Role:</strong> @Model.RoleName</p>
                </div>
            </div>

            @if (Model.HasOwnedContent)
            {
                <a class="btn btn-warning" href="@Url.Action("ReassignOwnership", new { id = Model.UserId })">Reassign Ownership</a>
                <a class="btn btn-default" href="@Url.Action("Index")">Back</a>
            }
            else
            {
                using (Html.BeginForm("Delete", "AdminUsers", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserId" />

                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a class="btn btn-default" href="@Url.Action("Index")">Cancel</a>
                }
            }
        </div>
    }
</div>