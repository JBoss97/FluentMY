@model FluentMY.ViewModels.AdminReassignEducatorViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Reassign Ownership";
}

<style>
    .reassign-shell {
        color: #1f2937;
    }

    .reassign-hero {
        border-radius: 24px;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
        padding: 30px;
        margin-bottom: 24px;
        box-shadow: 0 18px 36px rgba(245, 158, 11, 0.20);
    }

        .reassign-hero h2 {
            margin: 0 0 8px;
            font-weight: 900;
        }

    .reassign-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(15,23,42,0.06);
        box-shadow: 0 12px 28px rgba(15,23,42,0.06);
        padding: 24px;
    }

        .reassign-card .form-group {
            margin-bottom: 18px;
        }

        .reassign-card .form-control {
            border-radius: 12px;
            min-height: 44px;
        }

    .ownership-pill {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        margin-right: 8px;
        background: #fef3c7;
        color: #92400e;
    }
</style>

<div class="reassign-shell">
    <div class="reassign-hero">
        <h2>Reassign Educator Ownership</h2>
        <p>Transfer course and lesson ownership to another educator before deleting or changing this educator’s role.</p>
    </div>

    <div class="reassign-card">
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

        <p><strong>Current Educator:</strong> @Model.SourceEducatorName</p>

        <p>
            @if (Model.OwnedCourseCount > 0)
            {
                <span class="ownership-pill">@Model.OwnedCourseCount course(s)</span>
            }
            @if (Model.OwnedLessonCount > 0)
            {
                <span class="ownership-pill">@Model.OwnedLessonCount lesson(s)</span>
            }
        </p>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.SourceEducatorId)

            <div class="form-group">
                @Html.LabelFor(m => m.TargetEducatorId, "Transfer ownership to")
                @Html.DropDownListFor(m => m.TargetEducatorId, Model.AvailableEducators, "-- Select Educator --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.TargetEducatorId, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-warning">Reassign Ownership</button>
            <a class="btn btn-default" href="@Url.Action("Delete", new { id = Model.SourceEducatorId })">Back</a>
        }
    </div>
</div>