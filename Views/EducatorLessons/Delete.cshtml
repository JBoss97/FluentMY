@model FluentMY.Models.Lesson
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Lesson";
}

<style>
    .lesson-delete-shell {
        color: #1f2937;
    }

    .lesson-delete-hero {
        border-radius: 20px;
        background: linear-gradient(135deg, #dc3545 0%, #b02a37 100%);
        color: #fff;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 14px 30px rgba(220, 53, 69, 0.18);
    }

        .lesson-delete-hero h2 {
            margin: 0 0 8px;
            font-weight: 800;
        }

    .lesson-delete-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid rgba(15, 23, 42, 0.06);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06);
        padding: 24px;
    }

    .lesson-delete-meta {
        color: #6b7280;
        margin-top: 6px;
    }

    .lesson-delete-warning {
        margin-bottom: 18px;
    }

    .lesson-delete-actions .btn {
        border-radius: 12px;
        padding: 10px 16px;
        font-weight: 600;
        margin-right: 8px;
    }
</style>

<div class="lesson-delete-shell">
    <div class="lesson-delete-hero">
        <h2>Delete Lesson</h2>
        <p style="margin:0; color: rgba(255,255,255,0.88);">
            This action will permanently remove the selected lesson.
        </p>
    </div>

    <div class="lesson-delete-card">
        <div class="alert alert-warning lesson-delete-warning">
            Are you sure you want to delete this lesson?
        </div>

        <div class="panel panel-default" style="margin-bottom:20px;">
            <div class="panel-body">
                <h4 style="font-weight:800; margin-top:0;">@Model.Title</h4>
                <div class="lesson-delete-meta">
                    <strong>Course:</strong> @(Model.Course != null ? Model.Course.Title : "-")
                </div>
                <div class="lesson-delete-meta">
                    <strong>Difficulty Level:</strong> @(string.IsNullOrWhiteSpace(Model.DifficultyLevel) ? "-" : Model.DifficultyLevel)
                </div>
            </div>
        </div>

        @using (Html.BeginForm("Delete", "EducatorLessons", new { id = Model.LessonId }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="lesson-delete-actions">
                <button class="btn btn-danger" type="submit">Delete Lesson</button>
                <a class="btn btn-default" href="@Url.Action("Index", new { courseId = Model.CourseId })">Cancel</a>
            </div>
        }
    </div>
</div>