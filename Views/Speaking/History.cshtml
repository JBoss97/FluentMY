@using System
@model FluentMY.ViewModels.SpeakingHistoryPageViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Speaking History";

    var totalAttempts = Model != null ? Model.TotalAttempts : 0;
    var avgAccuracy = Model != null ? Model.AvgAccuracy : 0;
    var avgCompleteness = Model != null ? Model.AvgCompleteness : 0;
    var avgPronunciation = Model != null ? Model.AvgPronunciation : 0;
    var avgOverall = Model != null ? Model.AvgOverall : 0;
}

@functions {
    public int OverallScore(FluentMY.ViewModels.SpeakingHistoryItemViewModel item)
    {
        return (int)Math.Round(
            ((item.AccuracyScore ?? 0) +
             (item.CompletenessScore ?? 0) +
             (item.PronunciationScore ?? 0)) / 3m);
    }

    public string ShortText(string value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "-";

        var text = value.Trim();
        if (text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength) + "...";
    }

    public string ScoreClass(int score)
    {
        if (score >= 85) return "score-excellent";
        if (score >= 70) return "score-good";
        if (score >= 50) return "score-fair";
        return "score-low";
    }
}

<style>
    .history-shell {
        color: #1f2937;
    }

    .history-hero {
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd 0%, #0b4db7 100%);
        color: #fff;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 16px 35px rgba(13, 110, 253, 0.20);
    }

        .history-hero h2 {
            margin: 0 0 8px;
            font-weight: 800;
        }

        .history-hero p {
            margin: 0;
            color: rgba(255,255,255,0.88);
        }

    .hero-pills {
        margin-top: 14px;
    }

    .hero-pill {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,0.16);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        margin-right: 8px;
        margin-bottom: 8px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .summary-card,
    .history-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(15,23,42,0.06);
        box-shadow: 0 12px 28px rgba(15,23,42,0.06);
    }

    .summary-card {
        padding: 20px;
    }

    .summary-value {
        font-size: 30px;
        font-weight: 900;
        color: #0d6efd;
        line-height: 1.2;
    }

    .summary-label {
        margin-top: 6px;
        color: #6b7280;
        font-size: 13px;
        font-weight: 700;
    }

    .history-card {
        padding: 24px;
        margin-bottom: 20px;
    }

    .section-title {
        margin-top: 0;
        margin-bottom: 16px;
        font-weight: 800;
        color: #111827;
    }

    .history-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .history-filter-form {
        display: flex;
        align-items: end;
        gap: 12px;
        flex-wrap: wrap;
    }

    .history-filter-group label {
        display: block;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
    }

    .history-filter-group select {
        min-width: 220px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 8px 12px;
        background: #fff;
        cursor: pointer;
    }

    .history-table {
        margin-bottom: 0;
    }

        .history-table > thead > tr > th {
            border-top: none !important;
            font-weight: 700;
            color: #374151;
            vertical-align: middle;
        }

        .history-table > tbody > tr > td {
            vertical-align: top;
        }

    .lesson-title {
        font-weight: 700;
        color: #111827;
        margin-bottom: 4px;
    }

    .course-sub {
        color: #6b7280;
        font-size: 13px;
    }

    .prompt-text {
        font-weight: 600;
        color: #111827;
        line-height: 1.7;
        margin-bottom: 6px;
        max-width: 260px;
    }

    .recognized-box {
        max-width: 260px;
    }

    .recognized-main {
        color: #374151;
        line-height: 1.7;
        margin-bottom: 6px;
    }

    .small-muted {
        color: #6b7280;
        font-size: 12px;
    }

    .score-stack {
        min-width: 180px;
    }

    .overall-pill,
    .score-pill,
    .attempt-pill {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        margin-right: 6px;
        margin-bottom: 6px;
    }

    .overall-pill {
        background: #111827;
        color: #fff;
    }

    .score-pill {
        background: #eff6ff;
        color: #0d6efd;
    }

    .attempt-pill {
        background: #f3f4f6;
        color: #374151;
    }

    .score-excellent {
        background: #ecfdf3 !important;
        color: #15803d !important;
    }

    .score-good {
        background: #eff6ff !important;
        color: #1d4ed8 !important;
    }

    .score-fair {
        background: #fff7ed !important;
        color: #c2410c !important;
    }

    .score-low {
        background: #fef2f2 !important;
        color: #b91c1c !important;
    }

    .action-btns .btn {
        margin-right: 6px;
        margin-bottom: 6px;
        border-radius: 12px;
        font-weight: 700;
        padding: 8px 14px;
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        border: 1px dashed rgba(15,23,42,0.12);
        border-radius: 16px;
        background: #fff;
    }

        .empty-state h4 {
            margin-top: 0;
            margin-bottom: 8px;
            font-weight: 800;
        }

        .empty-state p {
            color: #6b7280;
            margin-bottom: 16px;
        }

    .history-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 18px;
        flex-wrap: wrap;
    }

    .history-page-links {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

        .history-page-links .btn {
            border-radius: 10px;
            min-width: 42px;
        }

    .footer-actions {
        margin-top: 18px;
    }

        .footer-actions .btn {
            border-radius: 12px;
            font-weight: 700;
            padding: 10px 16px;
            margin-right: 8px;
            margin-bottom: 8px;
        }
</style>

<div class="history-shell">
    <div class="history-hero">
        <h2>Speaking History</h2>
        <p>Review your pronunciation attempts, compare scores, and retry practice whenever needed.</p>

        <div class="hero-pills">
            <span class="hero-pill">Attempts: @totalAttempts</span>
            <span class="hero-pill">Average Overall: @avgOverall%</span>
        </div>
    </div>

    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-value">@totalAttempts</div>
            <div class="summary-label">Total Attempts</div>
        </div>

        <div class="summary-card">
            <div class="summary-value">@avgAccuracy</div>
            <div class="summary-label">Average Accuracy</div>
        </div>

        <div class="summary-card">
            <div class="summary-value">@avgCompleteness</div>
            <div class="summary-label">Average Completeness</div>
        </div>

        <div class="summary-card">
            <div class="summary-value">@avgPronunciation</div>
            <div class="summary-label">Average Pronunciation</div>
        </div>
    </div>

    <div class="history-card">
        <h3 class="section-title">Attempt Records</h3>

        <div class="history-toolbar">
            @using (Html.BeginForm("History", "Speaking", FormMethod.Get, new { @class = "history-filter-form" }))
            {
                <div class="history-filter-group">
                    <label for="SelectedLessonId">Filter by lesson</label>
                    @Html.DropDownListFor(
                        m => m.SelectedLessonId,
                        Model.LessonOptions,
                        new
                        {
                            onchange = "this.form.submit()"
                        })
                </div>

                if (Model.SelectedLessonId.HasValue)
                {
                    <div style="padding-top:28px;">
                        <a class="btn btn-default" href="@Url.Action("History", "Speaking", new { page = 1 })">
                            Clear Filter
                        </a>
                    </div>
                }
            }

            <div class="small-muted">
                @if (Model.TotalItems > 0)
                {
                    @:Showing @Model.StartItemNumber - @Model.EndItemNumber of @Model.TotalItems attempt(s)
                }
                else
                {
                    @:No attempts found
                }
            </div>
        </div>

        @if (Model == null || Model.Items == null || !Model.Items.Any())
        {
            <div class="empty-state">
                <h4>No speaking attempts yet</h4>
                <p>No speaking history matches the selected lesson yet.</p>
                <a class="btn btn-primary" href="@Url.Action("Index", "Student")">Go to Dashboard</a>
            </div>
        }
        else
        {
            <table class="table table-striped history-table">
                <thead>
                    <tr>
                        <th>Lesson</th>
                        <th>Prompt</th>
                        <th>Recognized Speech</th>
                        <th>Scores</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var overall = OverallScore(item);
                        <tr>
                            <td>
                                <div class="lesson-title">@item.LessonTitle</div>
                                <div class="course-sub">@item.CourseTitle</div>
                                <div style="margin-top:8px;">
                                    <span class="attempt-pill">Attempt #@item.AttemptNumber</span>
                                </div>
                            </td>

                            <td>
                                <div class="prompt-text" title="@item.PromptText">
                                    @ShortText(item.PromptText, 120)
                                </div>
                            </td>

                            <td>
                                <div class="recognized-box">
                                    <div class="recognized-main" title="@item.RecognizedText">
                                        @ShortText(item.RecognizedText, 120)
                                    </div>
                                    <div class="small-muted">Recognized by speech assessment</div>
                                </div>
                            </td>

                            <td>
                                <div class="score-stack">
                                    <span class="overall-pill @ScoreClass(overall)">Overall: @overall%</span>
                                    <span class="score-pill">A: @((item.AccuracyScore ?? 0).ToString("0"))</span>
                                    <span class="score-pill">C: @((item.CompletenessScore ?? 0).ToString("0"))</span>
                                    <span class="score-pill">P: @((item.PronunciationScore ?? 0).ToString("0"))</span>
                                </div>
                            </td>

                            <td>
                                <div>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</div>
                                <div class="small-muted">@item.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</div>
                            </td>

                            <td>
                                <div class="action-btns">
                                    <a class="btn btn-xs btn-primary"
                                       href="@Url.Action("Result", "Speaking", new { speakingAttemptId = item.SpeakingAttemptId })">
                                        View Result
                                    </a>

                                    <a class="btn btn-xs btn-info"
                                       href="@Url.Action("Start", "Speaking", new { exerciseId = item.ExerciseId, lessonId = item.LessonId })">
                                        Retry
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="history-pagination">
                <div class="small-muted">
                    Page @Model.CurrentPage of @Model.TotalPages
                </div>

                <div class="history-page-links">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="btn btn-default" href="@Url.Action("History", "Speaking", new { lessonId = Model.SelectedLessonId, page = 1 })">First</a>
                        <a class="btn btn-default" href="@Url.Action("History", "Speaking", new { lessonId = Model.SelectedLessonId, page = Model.CurrentPage - 1 })">Previous</a>
                    }

                    @{
                        var startPage = Model.CurrentPage - 2;
                        var endPage = Model.CurrentPage + 2;

                        if (startPage < 1)
                        {
                            startPage = 1;
                        }

                        if (endPage > Model.TotalPages)
                        {
                            endPage = Model.TotalPages;
                        }
                    }

                    @for (var i = startPage; i <= endPage; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <span class="btn btn-primary disabled">@i</span>
                        }
                        else
                        {
                            <a class="btn btn-default" href="@Url.Action("History", "Speaking", new { lessonId = Model.SelectedLessonId, page = i })">@i</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a class="btn btn-default" href="@Url.Action("History", "Speaking", new { lessonId = Model.SelectedLessonId, page = Model.CurrentPage + 1 })">Next</a>
                        <a class="btn btn-default" href="@Url.Action("History", "Speaking", new { lessonId = Model.SelectedLessonId, page = Model.TotalPages })">Last</a>
                    }
                </div>
            </div>
        }

        <div class="footer-actions">
            <a class="btn btn-default" href="@Url.Action("Index", "Student")">Back to Dashboard</a>
        </div>
    </div>
</div>