@model IEnumerable<FluentMY.ViewModels.CourseCatalogItemViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Courses";
}

<style>
    .course-catalog-shell {
        color: #1f2937;
    }

    .catalog-hero {
        border-radius: 24px;
        background: linear-gradient(135deg, #0d6efd 0%, #0b4db7 100%);
        color: #fff;
        padding: 32px;
        margin-bottom: 24px;
        box-shadow: 0 18px 36px rgba(13, 110, 253, 0.20);
    }

        .catalog-hero h2 {
            margin: 0 0 8px;
            font-weight: 800;
        }

        .catalog-hero p {
            margin: 0;
            color: rgba(255,255,255,0.9);
            max-width: 760px;
        }

    .catalog-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .catalog-note {
        color: #6b7280;
        font-size: 13px;
    }

    .course-grid-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(15, 23, 42, 0.06);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .course-grid-top {
        background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
        padding: 18px;
        border-bottom: 1px solid rgba(15, 23, 42, 0.05);
    }

    .course-title {
        font-weight: 800;
        font-size: 18px;
        margin-bottom: 4px;
        color: #111827;
        line-height: 1.35;
    }

    .course-meta {
        color: #6b7280;
        font-size: 13px;
    }

    .course-grid-body {
        padding: 18px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .course-desc {
        color: #4b5563;
        min-height: 52px;
        margin-bottom: 14px;
        line-height: 1.6;
    }

    .course-pill {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: #eff6ff;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 700;
        margin-right: 6px;
        margin-bottom: 6px;
    }

    .status-wrap {
        margin-top: 12px;
        margin-bottom: 12px;
        min-height: 28px;
    }

    .status-good,
    .status-pending,
    .status-locked {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        margin-right: 6px;
        margin-bottom: 6px;
    }

    .status-good {
        background: #ecfdf3;
        color: #15803d;
    }

    .status-pending {
        background: #fff7ed;
        color: #c2410c;
    }

    .status-locked {
        background: #f3f4f6;
        color: #4b5563;
    }

    .progress-wrap {
        margin-top: 6px;
        margin-bottom: 14px;
    }

    .progress-label {
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .progress-bar-shell {
        width: 100%;
        height: 12px;
        border-radius: 999px;
        background: #e5e7eb;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(135deg, #0d6efd 0%, #0b4db7 100%);
    }

    .course-actions {
        margin-top: auto;
        padding-top: 8px;
    }

        .course-actions .btn {
            margin-right: 8px;
            margin-bottom: 8px;
            border-radius: 12px;
            font-weight: 600;
        }

    .empty-state {
        background: #fff;
        border-radius: 20px;
        border: 1px dashed rgba(15, 23, 42, 0.14);
        padding: 36px 24px;
        text-align: center;
        color: #6b7280;
    }

        .empty-state h4 {
            font-weight: 800;
            color: #111827;
            margin-top: 0;
            margin-bottom: 8px;
        }

        .empty-state p {
            margin-bottom: 16px;
        }
</style>

<div class="course-catalog-shell">
    <div class="catalog-hero">
        <h2>Explore Courses</h2>
        <p>
            Browse language courses, enroll as a student, and continue learning with progress tracking and lesson-by-lesson practice.
        </p>
    </div>

    @if (TempData["CourseMessage"] != null)
    {
        <div class="alert alert-info">@TempData["CourseMessage"]</div>
    }

    <div class="catalog-toolbar">
        <div class="catalog-note">
            Choose a course to view lessons, enroll, and continue your learning journey.
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <h4>No courses available</h4>
            <p>There are no courses published yet. Please check again later.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                var progressWidth = "width:" + item.ProgressPercent + "%;";

                <div class="col-md-4" style="margin-bottom:20px;">
                    <div class="course-grid-card">
                        <div class="course-grid-top">
                            <div class="course-title">@item.Title</div>
                            <div class="course-meta">
                                @item.Language
                                @if (!string.IsNullOrWhiteSpace(item.Level))
                                {
                                    @: • @item.Level
                                }
                            </div>
                        </div>

                        <div class="course-grid-body">
                            <div class="course-desc">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "No course description available." : item.Description)
                            </div>

                            <div>
                                <span class="course-pill">@item.LessonCount lesson(s)</span>
                                @if (!string.IsNullOrWhiteSpace(item.EstimatedDuration))
                                {
                                    <span class="course-pill">@item.EstimatedDuration</span>
                                }
                            </div>

                            <div class="status-wrap">
                                @if (Request.IsAuthenticated && User.IsInRole("Student"))
                                {
                                    if (item.IsEnrolled)
                                    {
                                        if (item.IsCompleted)
                                        {
                                            <span class="status-good">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="status-pending">Enrolled</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="status-locked">Not Enrolled</span>
                                    }
                                }
                                else if (!Request.IsAuthenticated)
                                {
                                    <span class="status-locked">Login Required</span>
                                }
                            </div>

                            @if (Request.IsAuthenticated && User.IsInRole("Student") && item.IsEnrolled)
                            {
                                <div class="progress-wrap">
                                    <div class="progress-label">Progress: @item.ProgressPercent%</div>
                                    <div class="progress-bar-shell">
                                        <div class="progress-bar-fill" style="@progressWidth"></div>
                                    </div>
                                </div>
                            }

                            <div class="course-actions">
                                <a class="btn btn-default" href="@Url.Action("Details", "Courses", new { id = item.CourseId })">
                                    View Details
                                </a>

                                @if (Request.IsAuthenticated && User.IsInRole("Student"))
                                {
                                    if (!item.IsEnrolled)
                                    {
                                        using (Html.BeginForm("Enroll", "Courses", FormMethod.Post, new { style = "display:inline-block;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.CourseId" />
                                            <button type="submit" class="btn btn-primary">Enroll</button>
                                        }
                                    }
                                    else if (item.ContinueLessonId.HasValue)
                                    {
                                        <a class="btn btn-primary" href="@Url.Action("Details", "Lessons", new { id = item.ContinueLessonId.Value })">
                                            Continue
                                        </a>
                                    }
                                    else if (item.IsCompleted)
                                    {
                                        <span class="btn btn-success disabled">Completed</span>
                                    }
                                }
                                else if (!Request.IsAuthenticated)
                                {
                                    <a class="btn btn-primary"
                                       href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Details", "Courses", new { id = item.CourseId }) })">
                                        Login to Start
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>