@model FluentMY.ViewModels.EducatorDashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Educator Dashboard";
    var educatorName = string.IsNullOrWhiteSpace(Model.EducatorDisplayName) ? "Educator" : Model.EducatorDisplayName;
}

<style>
    .educator-shell {
        color: #1f2937;
    }

    .educator-hero {
        border-radius: 24px;
        background: linear-gradient(135deg, #0d6efd 0%, #0b4db7 100%);
        color: #fff;
        padding: 32px;
        margin-bottom: 26px;
        box-shadow: 0 18px 36px rgba(13, 110, 253, 0.20);
    }

    .educator-kicker {
        display: inline-block;
        background: rgba(255,255,255,0.16);
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }

    .educator-hero h2 {
        margin-top: 10px;
        margin-bottom: 10px;
        font-weight: 800;
    }

    .educator-hero p {
        color: rgba(255,255,255,0.9);
        max-width: 760px;
        margin-bottom: 18px;
    }

    .hero-actions .btn {
        margin-right: 10px;
        margin-bottom: 10px;
        border-radius: 12px;
        padding: 10px 16px;
        font-weight: 600;
    }

    .stats-row {
        margin-bottom: 6px;
    }

    .dashboard-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(15, 23, 42, 0.06);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
        padding: 22px;
        margin-bottom: 20px;
        height: 100%;
    }

        .dashboard-card h3,
        .dashboard-card h4 {
            font-weight: 800;
            margin-top: 0;
            margin-bottom: 10px;
        }

    .dashboard-muted {
        color: #6b7280;
    }

    .quick-stat {
        text-align: center;
        padding: 24px 18px;
    }

    .quick-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #0d6efd;
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .quick-stat-number {
        font-size: 32px;
        font-weight: 800;
        color: #0d6efd;
        margin-bottom: 4px;
    }

    .quick-stat-label {
        font-size: 13px;
        color: #6b7280;
    }

    .section-title {
        font-weight: 800;
        margin-top: 10px;
        margin-bottom: 16px;
    }

    .feature-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(15, 23, 42, 0.06);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
        padding: 22px;
        margin-bottom: 20px;
        height: 100%;
    }

        .feature-card .icon {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: #0d6efd;
            font-weight: 800;
            font-size: 20px;
            margin-bottom: 12px;
        }

        .feature-card p {
            color: #6b7280;
            margin-bottom: 16px;
        }

        .feature-card .btn {
            border-radius: 12px;
        }

    .action-list {
        padding-left: 18px;
        margin-bottom: 0;
    }

        .action-list li {
            margin-bottom: 8px;
            color: #4b5563;
        }

    .info-box {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(15, 23, 42, 0.06);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
        padding: 24px;
        margin-top: 8px;
    }

    .review-highlight {
        background: linear-gradient(135deg, #fff7ed 0%, #ffffff 100%);
        border: 1px solid rgba(249, 115, 22, 0.14);
    }

        .review-highlight .quick-stat-icon {
            background: #fff1e6;
            color: #ea580c;
        }

        .review-highlight .quick-stat-number {
            color: #ea580c;
        }

    @@media (max-width: 991px) {
        .educator-hero {
            padding: 24px;
        }
    }
</style>

<div class="educator-shell">
    <div class="educator-hero">
        <span class="educator-kicker">Educator Dashboard</span>
        <h2>Welcome back, @educatorName</h2>
        <p>
            Manage your courses, structure lessons, add exercises, and monitor student submissions
            from one focused teaching workspace.
        </p>

        <div class="hero-actions">
            <a class="btn btn-light" href="@Url.Action("Index", "EducatorCourses")">Manage Courses</a>
            <a class="btn btn-default" href="@Url.Action("Index", "EducatorLessons")">Manage Lessons</a>
            <a class="btn btn-default" href="@Url.Action("EditProfile", "Manage")">Edit Profile</a>
        </div>
    </div>

    <div class="row stats-row">
        <div class="col-md-3">
            <div class="dashboard-card quick-stat">
                <div class="quick-stat-icon">📚</div>
                <div class="quick-stat-number">@Model.TotalCourses</div>
                <div class="quick-stat-label">My Courses</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card quick-stat">
                <div class="quick-stat-icon">📘</div>
                <div class="quick-stat-number">@Model.TotalLessons</div>
                <div class="quick-stat-label">My Lessons</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card quick-stat">
                <div class="quick-stat-icon">📝</div>
                <div class="quick-stat-number">@Model.TotalExercises</div>
                <div class="quick-stat-label">My Exercises</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card quick-stat review-highlight">
                <div class="quick-stat-icon">✅</div>
                <div class="quick-stat-number">@Model.PendingReviewCount</div>
                <div class="quick-stat-label">Pending Reviews</div>
            </div>
        </div>
    </div>

    <h3 class="section-title">Teaching Tools</h3>

    <div class="row">
        <div class="col-md-4">
            <div class="feature-card">
                <div class="icon">📚</div>
                <h4>Manage Courses</h4>
                <p>
                    Create and maintain the courses you own before adding lessons and assessments.
                </p>
                <a class="btn btn-primary" href="@Url.Action("Index", "EducatorCourses")">Open Courses</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="icon">📘</div>
                <h4>Manage Lessons</h4>
                <p>
                    Organize lesson content inside your courses and keep the learning flow structured.
                </p>
                <a class="btn btn-default" href="@Url.Action("Index", "EducatorLessons")">Open Lessons</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="icon">✅</div>
                <h4>Review Submissions</h4>
                <p>
                    Check student quiz attempts lesson by lesson and provide meaningful educator feedback.
                </p>
                <a class="btn btn-default" href="@Url.Action("Index", "EducatorLessons")">Review by Lesson</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="dashboard-card">
                <h4>Workspace Overview</h4>
                <ul class="action-list">
                    <li><strong>@Model.TotalCourses</strong> courses owned by you</li>
                    <li><strong>@Model.TotalLessons</strong> lessons created by you</li>
                    <li><strong>@Model.TotalExercises</strong> exercises prepared inside your lessons</li>
                    <li><strong>@Model.TotalSubmissions</strong> learner submissions linked to your lessons</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="dashboard-card">
                <h4>Recommended workflow</h4>
                <ul class="action-list">
                    <li>Start by creating or opening one of your <strong>Courses</strong></li>
                    <li>Add lessons under that course</li>
                    <li>Create exercises inside each lesson</li>
                    <li>Review student submissions after quiz attempts</li>
                    <li>Provide targeted educator feedback where needed</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="info-box">
        <h4 style="font-weight:800; margin-top:0;">Profile & Account</h4>
        <p class="dashboard-muted">
            Keep your educator profile up to date so your account stays consistent across the platform.
        </p>
        <a class="btn btn-primary" href="@Url.Action("EditProfile", "Manage")">Edit Profile</a>
        <a class="btn btn-default" href="@Url.Action("ChangePassword", "Manage")">Change Password</a>
    </div>
</div>