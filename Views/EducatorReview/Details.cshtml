@model FluentMY.ViewModels.SubmissionResultViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Comment Submission";
}

<style>
    .review-detail-shell {
        color: #1f2937;
    }

    .review-detail-hero {
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd 0%, #0b4db7 100%);
        color: #fff;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 16px 35px rgba(13, 110, 253, 0.20);
    }

        .review-detail-hero h2 {
            margin: 0 0 8px;
            font-weight: 800;
        }

        .review-detail-hero p {
            margin: 0;
            color: rgba(255,255,255,0.88);
        }

    .review-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

        .review-toolbar .btn {
            border-radius: 12px;
            font-weight: 600;
            padding: 10px 16px;
        }

    .summary-card,
    .answer-card,
    .feedback-card,
    .form-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(15,23,42,0.06);
        box-shadow: 0 12px 28px rgba(15,23,42,0.06);
        padding: 22px;
        margin-bottom: 20px;
    }

    .section-title {
        font-weight: 800;
        margin-top: 0;
        margin-bottom: 14px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 14px;
    }

    .summary-box {
        background: #f8fafc;
        border-radius: 14px;
        padding: 14px;
    }

    .summary-label {
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .summary-value {
        font-size: 22px;
        font-weight: 800;
        color: #111827;
    }

    .summary-value-small {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
    }

    .answer-question {
        font-weight: 800;
        color: #111827;
        margin-bottom: 10px;
    }

    .answer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 10px;
        margin-bottom: 10px;
    }

    .answer-meta {
        color: #4b5563;
        margin-bottom: 6px;
    }

    .correct-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: #ecfdf3;
        color: #15803d;
        font-size: 12px;
        font-weight: 700;
    }

    .incorrect-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: 12px;
        font-weight: 700;
    }

    .pending-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: #fff7ed;
        color: #c2410c;
        font-size: 12px;
        font-weight: 700;
    }

    .feedback-item {
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid #eef2f7;
    }

        .feedback-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

    .feedback-meta {
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .feedback-text {
        color: #374151;
        margin-bottom: 0;
        white-space: pre-line;
    }

    .form-card textarea.form-control {
        border-radius: 12px;
        min-height: 120px;
    }

    .form-actions .btn {
        border-radius: 12px;
        padding: 10px 16px;
        font-weight: 600;
        margin-right: 8px;
    }

    .performance-good {
        color: #15803d;
    }

    .performance-mid {
        color: #c2410c;
    }

    .performance-low {
        color: #b91c1c;
    }

    .muted-small {
        color: #6b7280;
        font-size: 13px;
    }
</style>

<div class="review-detail-shell">
    <div class="review-detail-hero">
        <h2>Review Submission</h2>
        <p>
            <strong>Student:</strong> @Model.StudentName &nbsp;•&nbsp;
            <strong>Course:</strong> @Model.CourseTitle &nbsp;•&nbsp;
            <strong>Lesson:</strong> @Model.LessonTitle
        </p>
    </div>

    @if (TempData["ReviewMessage"] != null)
    {
        <div class="alert alert-success">@TempData["ReviewMessage"]</div>
    }

    <div class="review-toolbar">
        <div class="muted-small">View the learner’s answers and add educator feedback below.</div>
        <div>
            <a class="btn btn-default" href="@Url.Action("Index", "EducatorReview", new { lessonId = Model.LessonId })">Back to Submission List</a>
        </div>
    </div>

    <div class="summary-card">
        <h3 class="section-title">Submission Summary</h3>

        <div class="summary-grid">
            <div class="summary-box">
                <div class="summary-label">Attempt</div>
                <div class="summary-value">@Model.AttemptNumber</div>
            </div>

            <div class="summary-box">
                <div class="summary-label">Correct Answers</div>
                <div class="summary-value">@Model.CorrectAnswers / @Model.TotalQuestions</div>
            </div>

            <div class="summary-box">
                <div class="summary-label">Total Score</div>
                <div class="summary-value">@Model.TotalScore</div>
            </div>

            <div class="summary-box">
                <div class="summary-label">Percentage</div>
                <div class="summary-value @(Model.Percentage >= 80 ? "performance-good" : Model.Percentage >= 50 ? "performance-mid" : "performance-low")">
                    @Model.Percentage%
                </div>
            </div>

            <div class="summary-box">
                <div class="summary-label">Submitted</div>
                <div class="summary-value-small">@Model.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
            </div>

            <div class="summary-box">
                <div class="summary-label">Feedback Status</div>
                @if (Model.IsReviewed)
                {
                    <div>
                        <span class="correct-badge">Commented</span>
                        @if (Model.ReviewedAt.HasValue)
                        {
                            <div class="muted-small" style="margin-top:8px;">
                                @Model.ReviewedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div>
                        <span class="pending-badge">Pending</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <h3 class="section-title">Answer Details</h3>
    @foreach (var item in Model.Answers)
    {
        <div class="answer-card">
            <div class="answer-question">@item.QuestionText</div>

            <div class="answer-grid">
                <div class="answer-meta"><strong>Student Answer:</strong> @item.SelectedAnswer</div>
                <div class="answer-meta"><strong>Correct Answer:</strong> @item.CorrectAnswer</div>
                <div class="answer-meta"><strong>Score:</strong> @item.Score</div>
            </div>

            @if (item.IsCorrect)
            {
                <span class="correct-badge">Correct</span>
            }
            else
            {
                <span class="incorrect-badge">Incorrect</span>
            }
        </div>
    }

    <div class="feedback-card">
        <h3 class="section-title">Existing Feedback</h3>

        @if (Model.Feedbacks != null && Model.Feedbacks.Any())
        {
            foreach (var feedback in Model.Feedbacks)
            {
                <div class="feedback-item">
                    <div class="feedback-meta">
                        <strong>@feedback.FeedbackType</strong>
                        by @feedback.AuthorName on @feedback.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </div>
                    <p class="feedback-text">@feedback.CommentText</p>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info" style="margin-bottom:0;">No feedback yet.</div>
        }
    </div>

    <div class="form-card">
        <h3 class="section-title">Add Educator Feedback</h3>

        @using (Html.BeginForm("AddFeedback", "EducatorReview", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="submissionId" value="@Model.SubmissionId" />

            <div class="form-group">
                <textarea name="feedbackText" class="form-control" rows="5" placeholder="Write guidance, corrections, or suggestions for improvement..."></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Feedback</button>
                <a class="btn btn-default" href="@Url.Action("Index", "EducatorReview", new { lessonId = Model.LessonId })">Back</a>
            </div>
        }
    </div>
</div>
