@model FluentMY.ViewModels.LessonFinishViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lesson Complete";

    var totalAnswered = Model.CorrectCount + Model.WrongCount;
    var accuracy = totalAnswered == 0
        ? 0
        : (int)Math.Round((Model.CorrectCount * 100.0) / totalAnswered);

    var summaryMessage = "Good effort. Keep practicing to improve your accuracy.";

    if (Model.PerfectRun)
    {
        summaryMessage = "Excellent work. You completed this lesson perfectly.";
    }
    else if (accuracy >= 90)
    {
        summaryMessage = "Excellent work. Your accuracy was very strong.";
    }
    else if (accuracy >= 70)
    {
        summaryMessage = "Great job. You understood most of the lesson well.";
    }
    else if (accuracy >= 50)
    {
        summaryMessage = "Nice try. Review the lesson and try again to improve.";
    }

    var progressStyle = "width:" + accuracy + "%;";
}

<style>
    .finish-shell {
        color: #1f2937;
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .finish-card {
        max-width: 820px;
        margin: 30px auto;
        background: #fff;
        border-radius: 24px;
        border: 1px solid rgba(15,23,42,0.06);
        box-shadow: 0 18px 36px rgba(15,23,42,0.08);
        padding: 34px;
        text-align: center;
    }

    .finish-icon {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
        color: #0b4db7;
        font-weight: 800;
    }

    .stars {
        font-size: 38px;
        margin-bottom: 12px;
        line-height: 1.2;
    }

    .no-stars {
        color: #9ca3af;
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .finish-card h2 {
        margin: 0 0 8px;
        font-weight: 800;
        color: #111827;
    }

    .lesson-name {
        font-size: 18px;
        font-weight: 700;
        color: #1f2937;
    }

    .course-name {
        color: #6b7280;
        margin-top: 6px;
        margin-bottom: 18px;
    }

    .summary-message {
        max-width: 560px;
        margin: 0 auto 22px;
        color: #374151;
        font-size: 15px;
        line-height: 1.7;
    }

    .finish-meta {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin: 20px 0 18px;
    }

    .meta-pill {
        display: inline-block;
        padding: 9px 14px;
        border-radius: 999px;
        background: #eff6ff;
        color: #0b4db7;
        font-size: 13px;
        font-weight: 700;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 14px;
        margin-top: 22px;
        margin-bottom: 22px;
    }

    .stat-card {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 18px 14px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: #111827;
        line-height: 1.2;
    }

    .stat-label {
        margin-top: 6px;
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
    }

    .accuracy-wrap {
        max-width: 520px;
        margin: 0 auto 10px;
        text-align: left;
    }

    .accuracy-label {
        font-weight: 700;
        color: #111827;
        margin-bottom: 8px;
    }

    .progress {
        height: 14px;
        border-radius: 999px;
        overflow: hidden;
        background: #e5e7eb;
        margin-bottom: 0;
    }

    .perfect-run {
        margin-top: 8px;
        font-weight: 700;
        color: #15803d;
        font-size: 15px;
    }

    .finish-actions {
        margin-top: 26px;
    }

        .finish-actions .btn {
            border-radius: 12px;
            font-weight: 700;
            padding: 10px 16px;
            margin: 8px 6px 0;
            min-width: 140px;
        }

    .next-note {
        margin-top: 16px;
        color: #6b7280;
        font-size: 13px;
    }
</style>

<div class="finish-shell">
    <div class="finish-card">
        <div class="finish-icon">✓</div>

        @if (Model.StarsEarned > 0)
        {
            <div class="stars">
                @for (int i = 0; i < Model.StarsEarned; i++)
                {
                    @:⭐
                }
            </div>
        }
        else
        {
            <div class="no-stars">No stars earned this time</div>
        }

        <h2>Lesson Complete</h2>
        <div class="lesson-name">@Model.LessonTitle</div>
        <div class="course-name">@Model.CourseTitle</div>

        <div class="summary-message">
            @summaryMessage
        </div>

        <div class="finish-meta">
            <span class="meta-pill">Correct: @Model.CorrectCount</span>
            <span class="meta-pill">Wrong: @Model.WrongCount</span>
            <span class="meta-pill">XP Earned: @Model.TotalXP</span>
            <span class="meta-pill">Accuracy: @accuracy%</span>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">@Model.CorrectCount</div>
                <div class="stat-label">Correct Answers</div>
            </div>

            <div class="stat-card">
                <div class="stat-value">@Model.WrongCount</div>
                <div class="stat-label">Wrong Answers</div>
            </div>

            <div class="stat-card">
                <div class="stat-value">@Model.TotalXP</div>
                <div class="stat-label">XP Gained</div>
            </div>

            <div class="stat-card">
                <div class="stat-value">@Model.StarsEarned</div>
                <div class="stat-label">Stars Earned</div>
            </div>
        </div>

        <div class="accuracy-wrap">
            <div class="accuracy-label">Performance Progress</div>
            <div class="progress">
                <div class="progress-bar progress-bar-success" style="@progressStyle"></div>
            </div>
        </div>

        @if (Model.PerfectRun)
        {
            <div class="perfect-run">Perfect Run 🎉</div>
        }

        <div class="finish-actions">
            <a class="btn btn-default" href="@Url.Action("Details", "Lessons", new { id = Model.LessonId })">
                Back to Lesson
            </a>

            <a class="btn btn-primary" href="@Url.Action("Start", "LessonPlay", new { lessonId = Model.LessonId })">
                Retry Lesson
            </a>

            @if (Model.NextLessonId.HasValue)
            {
                <a class="btn btn-success" href="@Url.Action("Details", "Lessons", new { id = Model.NextLessonId.Value })">
                    Next Lesson
                </a>
                }
                else
                {
                <a class="btn btn-success" href="@Url.Action("Details", "Courses", new { id = Model.LessonId })">
                    Back to Course
                </a>
            }
        </div>

        <div class="next-note">
            Complete more lessons to build streaks, gain XP, and improve your language skills.
        </div>
    </div>
</div>